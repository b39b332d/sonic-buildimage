#!/bin/bash
TARGET_PATH=$1

. /usr/local/share/buildinfo/scripts/buildinfo_base.sh

[ -d ${TARGET_PATH} ] && rm -rf ${TARGET_PATH}
[ -z "$TARGET_PATH" ] && TARGET_PATH=$POST_VERSION_PATH

# Detect distribution
if [ -f /etc/os-release ]; then
    DIST=$(grep -E "^ID=" /etc/os-release | cut -d= -f2 | tr -d '"')
    VERSION_ID=$(grep -E "^VERSION_ID=" /etc/os-release | cut -d= -f2 | tr -d '"')
else
    DIST="unknown"
fi

# Detect architecture
if command -v dpkg &>/dev/null; then
    ARCH=$(dpkg --print-architecture)
elif command -v rpm &>/dev/null; then
    ARCH=$(rpm -q --qf '%{arch}' rpm 2>/dev/null || uname -m)
else
    ARCH=$(uname -m)
fi

mkdir -p $TARGET_PATH
chmod a+rw $TARGET_PATH

# Skip the package that does have a static build version.
# SAI package versions are changed too frequently.
SKIP_VERSION_PACKAGE="libsaibcm|libpaibcm|linuxptp|@ file://"

# Collect package versions based on package manager
if command -v dpkg-query &>/dev/null; then
    # Debian/Ubuntu based
    dpkg-query -W -f '${Package}==${Version}\n' | grep -Ev "${SKIP_VERSION_PACKAGE}" > "${TARGET_PATH}/versions-deb-${DIST}-${ARCH}"
elif command -v rpm &>/dev/null; then
    # RPM based (openEuler, CentOS, etc.)
    rpm -qa --queryformat '%{NAME}==%{VERSION}-%{RELEASE}\n' | grep -Ev "${SKIP_VERSION_PACKAGE}" > "${TARGET_PATH}/versions-rpm-${DIST}-${ARCH}"
fi

# Collect Python package versions
([ -x "/usr/local/bin/pip2" ] || [ -x "/usr/bin/pip2" ]) && pip2 freeze --all| grep -Ev "${SKIP_VERSION_PACKAGE}" > "${TARGET_PATH}/versions-py2-${DIST}-${ARCH}" 2>/dev/null || true
([ -x "/usr/local/bin/pip3" ] || [ -x "/usr/bin/pip3" ]) && pip3 freeze --all| grep -Ev "${SKIP_VERSION_PACKAGE}" > "${TARGET_PATH}/versions-py3-${DIST}-${ARCH}" 2>/dev/null || true

[ -f "${BUILD_WEB_VERSION_FILE}" ] && cp ${BUILD_WEB_VERSION_FILE} ${TARGET_PATH}
[ -f "${BUILD_GIT_VERSION_FILE}" ] && cp ${BUILD_GIT_VERSION_FILE} ${TARGET_PATH}

## Add the the packages purged
if [ -f $POST_VERSION_PATH/purge-versions-deb ]; then
    cat $POST_VERSION_PATH/purge-versions-deb >> "${TARGET_PATH}/versions-deb-${DIST}-${ARCH}" 2>/dev/null || true
fi
if [ -f $POST_VERSION_PATH/purge-versions-rpm ]; then
    cat $POST_VERSION_PATH/purge-versions-rpm >> "${TARGET_PATH}/versions-rpm-${DIST}-${ARCH}" 2>/dev/null || true
fi

## Add mirror versions (Debian/apt)
while read -r line; do
    mirror=$(echo "$line" | sed "s/.*\///" | sed "s/_InRelease.*//")
    date=$(date --date="$(echo "$line" | cut -d: -f3-)" +%Y-%m-%dT%H:%M:%SZ)
    echo "$mirror==$date" >> ${TARGET_PATH}/versions-mirror
done < <(grep Date: /var/lib/apt/lists/*_InRelease 2>/dev/null || true)

## Add repo metadata versions (RPM/dnf)
if [ -d /var/cache/dnf ]; then
    for repodata in /var/cache/dnf/*/repodata; do
        if [ -d "$repodata" ]; then
            repo_name=$(basename $(dirname "$repodata"))
            if [ -f "$repodata/repomd.xml" ]; then
                timestamp=$(stat -c %Y "$repodata/repomd.xml" 2>/dev/null || stat -f %m "$repodata/repomd.xml" 2>/dev/null)
                date=$(date -d "@$timestamp" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -r "$timestamp" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)
                [ -n "$date" ] && echo "$repo_name==$date" >> ${TARGET_PATH}/versions-mirror
            fi
        fi
    done
fi

## Print the unique and sorted result
for f in "${TARGET_PATH}"/versions-*; do
    [ -f "$f" ] && sort -u "$f" -o "$f"
done

exit 0
